// Simplified Jenkinsfile for beginners
// This is a basic version without advanced features

pipeline {
    agent any
    
    stages {
        stage('Checkout Code') {
            steps {
                echo '📦 Checking out code...'
                checkout scm
            }
        }
        
        stage('Install & Build') {
            steps {
                echo '🔧 Installing dependencies and building...'
                script {
                    if (isUnix()) {
                        sh '''
                            npm install
                            npm run build
                        '''
                    } else {
                        bat '''
                            npm install
                            npm run build
                        '''
                    }
                }
            }
        }
        
        stage('Deploy') {
            steps {
                echo '🚀 Deploying to Firebase...'
                script {
                    if (isUnix()) {
                        sh '''
                            npx firebase-tools deploy --only hosting
                        '''
                    } else {
                        bat '''
                            npx firebase-tools deploy --only hosting
                        '''
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo '✅ Deployment successful!'
        }
        failure {
            echo '❌ Deployment failed!'
        }
    }
}

